{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "必应壁纸",
  "version": "0.3.6",
  "identifier": "com.mybingwallpaper.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "必应壁纸",
        "width": 980,
        "height": 700,
        "minWidth": 720,
        "minHeight": 540,
        "center": true,
        "visible": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https://*.bing.com https://*.bing.net https://*.ee123.net; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "./assets/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": [
          "SimpChinese"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGQzA5NzMxQzE1ODhGMEUKUldRT2oxakJNWmZBTDBWTnFaSVRpaDlkY2ZXemdQK0E1eXNMK1Z3bDJLTjNyVyt1U1c5Umc5Q0cK",
      "endpoints": [
        "https://gitee.com/Hyman25/mybingwallpaper/raw/updater/latest.json",
        "https://github.com/hanhuang22/mybingwallpaper/releases/latest/download/latest.json"
      ]
    }
  }
}
